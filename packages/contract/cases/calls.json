      "status": "completed",
      "durationMs": 1,
      "toolDescription": {
        "$concat": [
          {
            "$prose": 1000
          },
          "\u2026[+500 chars]"
        ]
      },
      "truncated": [
        "toolDescription"
      ]
    }
