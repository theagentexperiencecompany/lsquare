  {
    "name": "a turn's answer is cut at 16,000 code points, with the exact count of the rest",
    "turn": {
      "answer": {
        "$prose": 20000
      }
    },
    "event": {
      "eventId": "$uuid",
      "schemaVersion": 2,
      "source": "live",
      "kind": "turn",
      "answer": {
        "$concat": [
          {
            "$prose": 16000
          },
          "\u2026[+4000 chars]"
        ]
      },
      "truncated": [
        "answer"
      ],
      "status": "completed"
    }
  },
  {
